# GitHub Linguist overrides, so the language bar reflects authored code.

# Generated: Unity-ROS message bindings, each stamped
# "Do not edit! This file was generated by Unity-ROS MessageGeneration."
Robotics_env_unity/Assets/RosMessages/** linguist-generated=true

# Generated: Unity writes one .meta sidecar per asset to track GUIDs.
*.meta linguist-generated=true

# Vendored: TurtleBot3 description package from ROBOTIS (Apache-2.0),
# https://github.com/ROBOTIS-GIT/turtlebot3
Robotics_env_unity/Assets/Robots/turtlebot3_description/** linguist-vendored=true

# Vendored: third-party art and shader packs imported into the Unity project.
Robotics_env_unity/Assets/Plugins/** linguist-vendored=true
"Robotics_env_unity/Assets/Lunar Base/**" linguist-vendored=true
"Robotics_env_unity/Assets/Lunar Landscape 3D/**" linguist-vendored=true
